{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "~/*": [
        "./src/ee/*",
        "./src/*"
      ],
      "@/*": [
        "./src/ee/*",
        "./src/*"
      ],
      "src/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules/**"
  ]
}
