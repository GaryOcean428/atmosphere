# Database
ATMOSPHERE_DB_JSON_FILE=/usr/app/data/db.json

# Redis
ATMOSPHERE_REDIS_URL=redis://your-redis-host:6379

# Public URL (email links, webhooks, OAuth redirects). Set to your public-facing URL.
ATMOSPHERE_SITE_URL=https://atmosphere.example.com

# Settings
ATMOSPHERE_SECURE_ATTACHMENTS=true
ATMOSPHERE_DISABLE_MUX=true
